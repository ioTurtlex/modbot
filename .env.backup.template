# ✅ BACKUP BOT ENVIRONMENT (.env.backup)
# Read-only bot - SAFE to leave running 24/7
# This bot only reads channels and backs up server state
# Cannot delete, modify, or cause harm

# Get this from Discord Developer Portal
# Go to: https://discord.com/developers/applications
# Select your backup bot → Bot section → Copy TOKEN
BACKUP_BOT_TOKEN=your_backup_bot_token_here

# Get this from Discord Developer Portal
# Go to: https://discord.com/developers/applications
# Select your backup bot → General Information → Copy CLIENT ID
BACKUP_BOT_CLIENT_ID=your_backup_bot_client_id_here

# Port for dashboard (optional)
BACKUP_BOT_PORT=3007

# Backup settings
MAX_BACKUPS=5
MAX_MESSAGES_PER_CHANNEL=1000
