# ModBot — Standalone AI Moderation Bot
# Copy this to .env and fill in your values

DISCORD_TOKEN=your_modbot_discord_token_here
CLIENT_ID=your_modbot_application_id_here
OPENAI_API_KEY=your_openai_api_key_here

# Optional: override the AI model used for moderation (default: gpt-4o-mini)
# MOD_MODEL=gpt-4o-mini
