# ⚠️  RESTORE BOT ENVIRONMENT (.env.restore)
# ⚠️  POWERFUL BOT - FULL ADMIN PERMISSIONS
# ⚠️  ONLY INVITE THIS BOT WHEN ACTIVELY RESTORING
# ⚠️  REMOVE THIS BOT FROM SERVER AFTER RESTORE COMPLETES
#
# This bot can delete everything:
#   - All channels and categories
#   - All roles
#   - All messages
#   - All webhooks
#   - Ban/kick members
#
# SECURITY BEST PRACTICES:
# 1. Never leave this bot invited - only use during restore
# 2. Use .env.restore file (separate from moderation bot)
# 3. Regenerate token after each restore (Discord Developer Portal)
# 4. Keep token extremely secure - if compromised, bot can destroy server
# 5. Only share token with trusted admins who need restore capability

# Get this from Discord Developer Portal
# Go to: https://discord.com/developers/applications
# Select your restore bot → Bot section → Copy TOKEN
# ⚠️ REGENERATE THIS TOKEN AFTER EACH RESTORE
RESTORE_BOT_TOKEN=your_restore_bot_token_here

# Get this from Discord Developer Portal
# Go to: https://discord.com/developers/applications
# Select your restore bot → General Information → Copy CLIENT ID
RESTORE_BOT_CLIENT_ID=your_restore_bot_client_id_here

# Restore settings
MAX_MESSAGES_PER_CHANNEL=1000
