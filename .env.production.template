# ModBot Production Environment (.env)
# Token: paste from Discord Developer Portal
# Keep this file secure — never commit to GitHub

# Discord Bot Token (get from https://discord.com/developers/applications)
# CREATE NEW BOT with name "Jelly Guardian"
# Set permissions to 8208 (MANAGE_MESSAGES + SEND_MESSAGES only)
DISCORD_TOKEN=your_bot_token_here_replace_in_production

# Port for dashboard (nginx will proxy to this)
DASHBOARD_PORT=3006

# Dashboard password (set to something strong)
DASHBOARD_PASSWORD=your_dashboard_password_here

# Bot settings
BOD_NAME=Jelly Guardian
OWNER_ID=lexi_discord_id_here

# Feature flags
FEATURE_SHADOW_MODE=true
FEATURE_REPLY_CONTEXT=true
FEATURE_ROLE_EXEMPTIONS=true

# Log settings
LOG_LEVEL=info
LOG_FILE=/var/log/modbot/modbot.log
